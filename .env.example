# =====================================================================
#  PhysioPro Osteopathie-Termine – Environment Variablen (VORLAGE)
#  Echte Werte NICHT hier eintragen – nur direkt in Netlify
#  (Site settings -> Environment variables -> "Import from .env").
#  Die realen Werte liegen in der separaten Dienstleister-Anweisung.
# =====================================================================

# --- SICHERHEITSSCHALTER ---
# Solange dies NICHT exakt "true" ist, werden KEINE echten E-Mails versendet (nur Log).
# Erst auf "true" setzen, wenn nach dem Testen wirklich live gegangen werden soll.
LIVE_MODE=false

# --- Google Sheets (Datenbank) ---
# Service Account des Fahrtenbuchs wiederverwenden (Werte 1:1 aus physiofahrtenbuch-ENV).
SHEET_ID=GOOGLE_SHEET_ID
GOOGLE_CLIENT_EMAIL=SERVICE_ACCOUNT@PROJEKT.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# --- Microsoft Graph (E-Mail-Versand) ---
# Azure-App "PhysioPro Osteo-Termine Mailer", Mail.Send + Admin-Consent erteilt.
GRAPH_TENANT_ID=AZURE_TENANT_ID
GRAPH_CLIENT_ID=AZURE_CLIENT_ID
GRAPH_CLIENT_SECRET=AZURE_CLIENT_SECRET
GRAPH_SENDER=info@physioproluebeck.de

# --- WhatsApp Cloud API (Meta) – SPÄTER ---
# Aktuell NICHT in Verwendung. Erinnerungen laufen vorerst per E-Mail.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TPL_3D=osteo_erinnerung_3d
# WHATSAPP_TPL_24H=osteo_erinnerung_24h
# WHATSAPP_TPL_LANG=de
